<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup>
		<DocsGeneratorProject>$(MSBuildThisFileDirectory)../LumexUI.Docs.Generator/LumexUI.Docs.Generator.csproj</DocsGeneratorProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../LumexUI.Docs.Client/LumexUI.Docs.Client.csproj" />
		<ProjectReference Include="../LumexUI.Docs.Generator/LumexUI.Docs.Generator.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Build inputs for the Tailwind CLI, not part of the site. -->
		<Content Remove="package.json;pnpm-lock.yaml" />
	</ItemGroup>

	<!--
		Build the generator through MSBuild so a solution build shares one build of it,
		then run it without building. A plain `dotnet run` rebuilt the generator in a
		separate process and raced the solution build on its deps.json.
	-->
	<Target Name="RunDocsGenerator" BeforeTargets="BeforeBuild">
		<MSBuild Projects="$(DocsGeneratorProject)" Targets="Build" />
		<Exec Command="dotnet run --no-build -c $(Configuration) --project &quot;$(DocsGeneratorProject)&quot;" />
	</Target>

	<!--
		The Tailwind CLI comes from npm (package.json), so Renovate sees its version and the pnpm lockfile pins its
		integrity hashes. Building the docs therefore needs Node and pnpm (mise.toml), like src/LumexUI.
	-->
	<Target Name="DocsPnpmInstall" AfterTargets="Build" Condition="!Exists('node_modules')">
		<Exec Command="pnpm install --frozen-lockfile" />
	</Target>

	<Target Name="RunTailwind" AfterTargets="DocsPnpmInstall">
		<Exec Command="pnpm exec tailwindcss -i ./Styles/globals.css -o ./wwwroot/css/docs.css" Condition="'$(Configuration)' == 'Debug'" />
		<Exec Command="pnpm exec tailwindcss -i ./Styles/globals.css -o ./wwwroot/css/docs.css --minify" Condition="'$(Configuration)' == 'Release'" />
	</Target>

</Project>
