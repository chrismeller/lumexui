<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- The maintained LumexUI.Motion fork. GitHub Packages needs a token with read:packages to restore. -->
    <add key="chrismeller" value="https://nuget.pkg.github.com/chrismeller/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="chrismeller">
      <package pattern="LumexUI.Motion" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
