<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup>
		<Title>LumexUI</Title>
		<Description>🚀 A versatile Blazor UI library built using Tailwind CSS.</Description>
		<Version>2.5.0</Version>
		<Authors>desmondinho;chrismeller</Authors>
		<PackageId>LumexUI</PackageId>
		<PackageIcon>logo.png</PackageIcon>
		<PackageTags>blazor;components;library;tailwindcss;</PackageTags>
		<PackageProjectUrl>https://github.com/chrismeller/lumexui</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/chrismeller/lumexui</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<PropertyGroup>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>
			$(TargetsForTfmSpecificContentInPackage);AddIconsToOutput
		</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE" Pack="true" Visible="false" PackagePath="" />
		<None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="" />
		<None Include="..\..\logo.png" Pack="true" Visible="false" PackagePath="" />
		<None Include="LumexUI.targets" Pack="true" PackagePath="buildTransitive\LumexUI.targets" />
		<None Include="Styles\*.cs" Pack="true" PackagePath="theme\components\%(Filename)%(Extension)" />
		<None Include="Styles\_dark.css;Styles\_light.css;Styles\_layout.css;Styles\_sonner.css;Styles\_tw-animate.css" Pack="true" PackagePath="theme" />
		<None Include="Styles\_theme.css" Pack="true" PackagePath="theme\theme.css" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.34" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net9.0' ">
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.23" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Blazor.Sonner" Version="0.0.5" />
		<PackageReference Include="LumexUI.Motion" Version="0.1.0" />
		<PackageReference Include="TailwindMerge.NET" Version="1.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LumexUI.Shared.Icons\LumexUI.Shared.Icons.csproj" PrivateAssets="all" />
	</ItemGroup>

	<Target Name="AddIconsToOutput">
		<ItemGroup>
			<TfmSpecificPackageFile Include="$(OutputPath)\$(AssemblyName).Shared.Icons.dll" PackagePath="lib\$(TargetFramework)" />
		</ItemGroup>
	</Target>
	
	<!-- Install the JS dependencies with pnpm if 'node_modules' is not present -->
	<Target Name="Npm" AfterTargets="Build" Condition="!Exists('node_modules')">
		<Message Text="Running pnpm install..." Importance="high" />
		<Exec Command="pnpm install --frozen-lockfile" />
	</Target>

	<!-- Run the rollup after npm dependencies are installed -->
	<Target Name="Rollup" AfterTargets="Npm">
		<Message Text="Running rollup..." Importance="high" />
		<Exec Command="pnpm exec rollup -c" />
	</Target>

	<!-- Remove these files from the build output -->
	<ItemGroup>
		<Content Remove="package.json" />
		<Content Remove="pnpm-lock.yaml" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="LumexUI.Docs" />
		<InternalsVisibleTo Include="LumexUI.Docs.Client" />
		<InternalsVisibleTo Include="LumexUI.Tests" />
	</ItemGroup>

</Project>
