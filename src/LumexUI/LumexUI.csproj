<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup>
		<Title>LumexUI</Title>
		<Description>🚀 A versatile Blazor UI library built using Tailwind CSS.</Description>
		<Version>2.5.0</Version><!-- x-release-please-version -->
		<Authors>desmondinho;chrismeller</Authors>
		<PackageId>LumexUI</PackageId>
		<PackageIcon>logo.png</PackageIcon>
		<PackageTags>blazor;components;library;tailwindcss;</PackageTags>
		<PackageProjectUrl>https://github.com/chrismeller/lumexui</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/chrismeller/lumexui</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<PropertyGroup>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>
			$(TargetsForTfmSpecificContentInPackage);AddIconsToOutput
		</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE" Pack="true" Visible="false" PackagePath="" />
		<None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="" />
		<None Include="..\..\logo.png" Pack="true" Visible="false" PackagePath="" />
		<None Include="LumexUI.targets" Pack="true" PackagePath="buildTransitive\LumexUI.targets" />
		<None Include="Styles\*.cs" Pack="true" PackagePath="theme\components\%(Filename)%(Extension)" />
		<None Include="Styles\_dark.css;Styles\_light.css;Styles\_layout.css;Styles\_sonner.css;Styles\_tw-animate.css" Pack="true" PackagePath="theme" />
		<None Include="Styles\_theme.css" Pack="true" PackagePath="theme\theme.css" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Blazor.Sonner" Version="0.0.5" />
		<PackageReference Include="LumexUI.Motion" Version="0.1.0" />
		<PackageReference Include="TailwindMerge.NET" Version="1.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LumexUI.Shared.Icons\LumexUI.Shared.Icons.csproj" PrivateAssets="all" />
	</ItemGroup>

	<Target Name="AddIconsToOutput">
		<ItemGroup>
			<TfmSpecificPackageFile Include="$(OutputPath)\$(AssemblyName).Shared.Icons.dll" PackagePath="lib\$(TargetFramework)" />
		</ItemGroup>
	</Target>
	
	<!--
		Bundles wwwroot/js/components/popover.js with @floating-ui/dom into popover.bundle.js. The bundle is
		generated, not committed, so building this project needs Node and pnpm (mise.toml). It runs before the
		build so the static web assets pick the file up.
	-->
	<PropertyGroup>
		<PopoverBundle>wwwroot/js/components/popover.bundle.js</PopoverBundle>
	</PropertyGroup>

	<Target Name="PnpmInstall" Condition="!Exists('node_modules')">
		<Exec Command="pnpm install --frozen-lockfile" />
	</Target>

	<Target Name="BundleJsCore"
			DependsOnTargets="PnpmInstall"
			Inputs="wwwroot/js/components/popover.js;package.json;pnpm-lock.yaml;rollup.config.mjs"
			Outputs="$(PopoverBundle)">
		<Exec Command="pnpm exec rollup -c" />
	</Target>

	<!--
		Each target framework builds in parallel. Calling the bundle step on the project without a TargetFramework
		gives every inner build the same project instance, so MSBuild runs it once and the others wait for it.
	-->
	<Target Name="BundleJs" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
		<MSBuild Projects="$(MSBuildProjectFullPath)" Targets="BundleJsCore" RemoveProperties="TargetFramework" />
	</Target>

	<!-- Make sure a bundle that didn't exist when the project was evaluated is still a static web asset. -->
	<Target Name="IncludeJsBundle" AfterTargets="BundleJs" Condition="'$(DesignTimeBuild)' != 'true'">
		<ItemGroup>
			<Content Remove="$(PopoverBundle)" />
			<Content Include="$(PopoverBundle)" />
		</ItemGroup>
	</Target>

	<!-- Remove these files from the build output -->
	<ItemGroup>
		<Content Remove="package.json" />
		<Content Remove="pnpm-lock.yaml" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="LumexUI.Docs" />
		<InternalsVisibleTo Include="LumexUI.Docs.Client" />
		<InternalsVisibleTo Include="LumexUI.Tests" />
	</ItemGroup>

</Project>
